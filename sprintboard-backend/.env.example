# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
# Use a private MongoDB instance and a least-privilege user in production.
MONGODB_URI=mongodb://127.0.0.1:27017/sprintboard

# Cookies are Secure automatically when NODE_ENV=production. Use HTTPS in production.
COOKIE_NAME=sb_session
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=7
CSRF_TTL_HOURS=12

# File storage directory. Keep outside public web roots and back it up.
UPLOAD_DIR=./storage/uploads
MAX_AVATAR_BYTES=2097152
MAX_ATTACHMENT_BYTES=10485760

# Link origin used in password reset emails
APP_ORIGIN=http://localhost:5173

# Optional SMTP; without SMTP, development logs reset links but production never does.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SprintBoard <no-reply@example.com>
# Allows an admin to copy and manually deliver setup links when SMTP is unavailable.
# Enable only when the admin UI is trusted and APP_ORIGIN is publicly reachable over HTTPS.
ALLOW_MANUAL_INVITES=false

# First admin creation: set before `npm run seed:admin`; use a strong unique password.
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Development-only demo seed; keep the admin and employee passwords different.
DEMO_ADMIN_PASSWORD=DemoAdminPass123!
DEMO_EMPLOYEE_PASSWORD=DemoEmployeePass123!
